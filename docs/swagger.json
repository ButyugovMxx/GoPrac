{
    "swagger": "2.0",
    "info": {
        "description": "HTTP API for loading movies from an external service.",
        "title": "Movie Service API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/last-movie": {
            "get": {
                "description": "Finds the movie with the highest available ID.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "movies"
                ],
                "summary": "Get last available movie",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/domain.Movieload"
                        }
                    },
                    "404": {
                        "description": "Movie not found",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "502": {
                        "description": "Upstream error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/load-movies": {
            "get": {
                "description": "Loads movies from the external movie service.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "movies"
                ],
                "summary": "Load movies by ID range",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "First movie ID",
                        "name": "from",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "Last movie ID",
                        "name": "to",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/domain.Movieload"
                            }
                        },
                        "headers": {
                            "X-Partial-Errors": {
                                "type": "string",
                                "description": "JSON array of per-movie errors, present when some movies could not be loaded"
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid range",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "502": {
                        "description": "Upstream error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "domain.Movieload": {
            "type": "object",
            "properties": {
                "director": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "title": {
                    "type": "string"
                },
                "year": {
                    "type": "integer"
                }
            }
        }
    }
}